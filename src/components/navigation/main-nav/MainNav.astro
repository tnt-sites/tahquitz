---
import { externalLinkAttrs } from "@component-utils/externalLink";
import Bar from "@components/navigation/bar/Bar.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";

// Site header: phone + address | logo | Book Online + Virtual Consultation, with the menu bar underneath.
// Shrinks to the condensed header (no address or virtual consult) once the page is scrolled.
const {
  logoSource,
  logoAlt = "logo",
  navData = [],
  pageButtons = [],
  socials = [],
  offices = [],
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);
const office = resolvedOffices[0] ?? {};
const phone = office.phones?.[0];
const address = office.addresses?.[0];
const addressText = address
  ? [
      ...(address.lines ?? []),
      address.city,
      [address.state, address.postalCode].filter(Boolean).join(" "),
    ]
      .filter(Boolean)
      .join(", ")
  : "";

const sharedSocials = socials.length > 0 ? socials : ((siteInfoData as any).socials ?? []);
const [bookButton, virtualButton] = pageButtons;
const mobileNavData = [
  ...navData,
  ...pageButtons.map((button: any) => ({ name: button.text, path: button.link, children: [] })),
];
---

<header class:list={["main-nav", className]} {...htmlAttributes}>
  <div class="top block lg:flex justify-between items-center">
    <div class="contact">
      {
        phone && (
          <a class="phone" href={phone.href}>
            <Icon name="device-phone-mobile" size="none" aria-hidden="true" />
            {phone.display}
          </a>
        )
      }
      {
        addressText && (
          <a class="address" href={address.mapUrl} target="_blank" rel="noopener noreferrer">
            {addressText}
          </a>
        )
      }
    </div>
    <a class="logo" href="/">
      <Image source={logoSource} alt={logoAlt} editable={false} priority={true} />
    </a>
    <div class="actions">
      {
        bookButton && (
          <a class="book" href={bookButton.link} {...externalLinkAttrs(bookButton.link)}>
            {bookButton.iconName && (
              <Icon name={bookButton.iconName} size="none" aria-hidden="true" />
            )}
            {bookButton.text}
          </a>
        )
      }
      {
        virtualButton && (
          <a class="virtual" href={virtualButton.link} {...externalLinkAttrs(virtualButton.link)}>
            {virtualButton.iconName && (
              <Icon name={virtualButton.iconName} size="none" aria-hidden="true" />
            )}
            {virtualButton.text}
          </a>
        )
      }
    </div>
    <Mobile
      logoSource={logoSource}
      logoAlt={logoAlt}
      navData={mobileNavData}
      class="mobile-main-nav"
      offices={resolvedOffices}
      sharedSocials={sharedSocials}
    />
  </div>
  <div class="menu">
    <Bar navData={navData} class="desktop-main-nav" />
  </div>
</header>

<!-- Sets --site-header-height and toggles the condensed header on scroll -->
<script>
  const initMainNav = () => {
    document.querySelectorAll<HTMLElement>(".main-nav").forEach((mainNav) => {
      if (mainNav.dataset.initialized === "true") return;

      const syncHeaderHeight = () => {
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${Math.round(mainNav.getBoundingClientRect().height)}px`
        );
      };

      // Separate on/off points so the header doesn't flicker while it changes height
      const syncCondensed = () => {
        if (window.scrollY > 200) mainNav.classList.add("condensed");
        else if (window.scrollY < 50) mainNav.classList.remove("condensed");
      };

      syncHeaderHeight();
      syncCondensed();
      window.addEventListener("scroll", syncCondensed, { passive: true });

      if (typeof ResizeObserver !== "undefined") {
        new ResizeObserver(syncHeaderHeight).observe(mainNav);
      }

      mainNav.dataset.initialized = "true";
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainNav);
  } else {
    initMainNav();
  }
</script>

<style>
  .main-nav {
    position: sticky;
    top: 0;
    z-index: var(--layer-2);
    background-color: var(--color-bg-dark);
    color: #ffffff;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 15px;
  }

  .contact,
  .actions,
  .menu {
    display: none;
  }

  .logo {
    display: block;
    padding: 10px 0;
  }

  .logo :global(img) {
    display: block;
    width: 200px;
    height: auto;
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 25px;
    border: 1px solid #ffffff;
    color: #ffffff;
    font-family: var(--font-accent);
    font-size: 20px;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .phone :global(.icon) {
    width: 20px;
    height: 25px;
  }

  .address {
    display: block;
    margin-top: 10px;
    color: #ffffff;
    font-size: 14px;
    text-decoration: none;
  }

  .phone:hover,
  .address:hover {
    color: var(--color-brand);
  }

  .book,
  .virtual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--color-text);
    font-family: var(--font-accent);
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color var(--animation-normal) ease-in-out;
  }

  .book {
    padding: 10px 35px;
    background-color: var(--color-brand);
    font-size: 20px;
  }

  .book :global(.icon) {
    width: 25px;
  }

  .virtual {
    margin-top: 5px;
    padding: 5px 20px;
    background-color: #ffffff;
    font-size: 12px;
  }

  .virtual :global(.icon) {
    width: 15px;
  }

  .book:hover,
  .virtual:hover {
    background-color: var(--color-brand-muted);
    color: var(--color-text);
  }

  /* Mobile slide-out panel: navy top bar so the white logo shows */
  :global(.mobile-main-nav .mobile-header) {
    background-color: var(--color-bg-dark);
  }

  :global(.mobile-nav-button) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 10px;
    border: none;
    border-radius: 0;
    background-color: var(--color-brand);
    color: var(--color-text);
  }

  :global(.mobile-nav-button .icon) {
    font-size: 30px;
  }

  :global(.nav-hamburger .mobile-nav-button) {
    flex-direction: column;
    gap: 0;
    height: 65px;
    width: 65px;
  }

  :global(.nav-hamburger .mobile-nav-button::after) {
    content: "Menu";
    font-size: 12px;
    font-weight: 400;
  }

  @media (min-width: 1025px) {
    .top {
      padding: 15px 20px;
    }

    .contact {
      display: block;
      text-align: center;
    }

    .actions {
      display: block;
    }

    .logo {
      padding: 0;
    }

    .logo :global(img) {
      width: 300px;
    }

    .menu {
      display: block;
      border-top: 1px solid rgba(255, 255, 255, 0.5);
    }

    :global(.nav-hamburger) {
      display: none;
    }

    .condensed .top {
      padding-block: 5px;
    }

    .condensed .address,
    .condensed .virtual {
      display: none;
    }

    .condensed .phone {
      padding-block: 5px;
      font-size: 16px;
    }

    .condensed .logo :global(img) {
      width: 200px;
    }

    .condensed .book {
      padding: 5px 25px;
      font-size: 16px;
    }
  }
</style>
