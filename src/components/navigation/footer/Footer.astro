---
import toothLogo from "@assets/images/tooth-logo-white.svg";
import { externalLinkAttrs } from "@component-utils/externalLink";
import Icon from "@core-elements/icon/Icon.astro";
import siteInfoData from "@data/siteInfo.json";
import { Icon as AstroIcon } from "astro-icon/components";

// Site footer: navy band with the tooth logo in a circle on its top edge, the "Ask Us a Question" form,
// then Contact Us | Office Hours; white legal bar underneath. Contact details come from siteInfo.json,
// the headings, form and legal links from footer.json.
const {
  socials = [],
  siteName = "",
  offices = [],
  legalLinks = [],
  contactTitle = "Contact Us",
  officeHoursTitle = "Office Hours",
  formHeading = "Ask Us a Question",
  formAction = "",
  consentText = "",
  // Older footer.json fields this design doesn't show
  logoSource,
  logoAlt,
  links,
  _component,
  ...htmlAttributes
} = Astro.props;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);
const displaySiteName = siteName || (siteInfoData as any).siteName || "";
const sharedSocials =
  Array.isArray(socials) && socials.length > 0 ? socials : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  return [...(address?.lines ?? []), cityStatePostal].filter(Boolean);
};

const copyYear = new Date().getFullYear();
---

<footer class="footer" {...htmlAttributes}>
  <section class="main">
    <a class="badge" href="/" aria-label={`${displaySiteName} home`}>
      <img src={toothLogo.src} alt="" width="150" height="145" loading="lazy" />
    </a>

    <div class="ask">
      <h2>{formHeading}</h2>
      <form action={formAction} method="post">
        <div class="fields block lg:flex">
          <label>
            <span class="sr-only">Name</span>
            <input type="text" name="name" placeholder="Name" required />
          </label>
          <label>
            <span class="sr-only">Email</span>
            <input type="email" name="email" placeholder="Email" required />
          </label>
          <label>
            <span class="sr-only">Phone</span>
            <input type="tel" name="phone" placeholder="Phone" />
          </label>
        </div>
        <label>
          <span class="sr-only">Message</span>
          <textarea name="message" placeholder="Message" rows="4"></textarea>
        </label>
        {
          consentText && (
            <label class="consent">
              <input type="checkbox" name="consent" value="yes" required />
              <span>{consentText}</span>
            </label>
          )
        }
        <button type="submit">Submit</button>
      </form>
    </div>

    <div class="info block lg:flex justify-center">
      {
        resolvedOffices.map((office: any) => (
          <article class="contact">
            <h3>{contactTitle}</h3>
            {office?.phones?.map((phone: any) => (
              <a class="phone" href={phone.href}>
                {phone.display}
              </a>
            ))}
            {office?.addresses?.map((address: any) => (
              <a class="address" href={address.mapUrl} {...externalLinkAttrs(address.mapUrl)}>
                {formatAddressLines(address).map((line: string, index: number) => (
                  <>
                    {index > 0 && <br />}
                    {line}
                  </>
                ))}
              </a>
            ))}
            {sharedSocials.length > 0 && (
              <ul class="socials no-check">
                {sharedSocials.map((social: any) => (
                  <li>
                    <a
                      href={social.link}
                      aria-label={social.label || social.icon}
                      {...externalLinkAttrs(social.link)}
                    >
                      <Icon name={social.icon} size="none" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
      {
        resolvedOffices.map((office: any) => (
          <article class="hours">
            <h3>{officeHoursTitle}</h3>
            <dl>
              {(office?.officeHours ?? []).map((item: any) => (
                <div>
                  <dt>{item.day}</dt>
                  {/* Text like "By Appointment Only" is italic, times are not */}
                  <dd class:list={{ "no-time": !/\d/.test(item.hours ?? "") }}>{item.hours}</dd>
                </div>
              ))}
            </dl>
            {office?.officeHoursNote && <p class="note">{office.officeHoursNote}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <div class="legal block lg:flex justify-between items-center">
    <p>
      &copy;{copyYear}
      {displaySiteName}
      <span class="links">
        {
          legalLinks.map((item: any) => (
            <>
              <span class="separator" aria-hidden="true">
                |
              </span>
              <a href={item.path} {...externalLinkAttrs(item.path)}>
                {item.name}
              </a>
            </>
          ))
        }
      </span>
    </p>
    <p class="credit">
      Site designed &amp; maintained by
      <a
        href="https://www.tntdental.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="TNT Dental"
      >
        <AstroIcon name="brands/tnt" aria-hidden="true" />
      </a>
    </p>
  </div>
</footer>

<style>
  /* Room for the fixed mobile tabs */
  @media (max-width: 1024px) {
    .footer[data-fixed-tabs-active="true"] {
      padding-bottom: 70px;
    }
  }

  /* Extra room at the bottom of the last page section so the logo circle doesn't cover its content */
  :global(
    main > section:last-child::after,
    main > editable-array > editable-array-item:last-child > section::after
  ) {
    content: "";
    display: block;
    height: 55px;
  }

  .main {
    background: var(--color-bg-dark) url("../../../assets/images/bg-triangles.webp") center / cover;
    color: #fff;
    padding: 110px 20px 50px;
    position: relative;
  }

  /* Navy circle half above the band, holding the tooth logo */
  .badge {
    align-items: flex-start;
    background-color: var(--color-bg-dark);
    border-radius: 50%;
    display: flex;
    height: 160px;
    justify-content: center;
    left: 50%;
    padding-top: 30px;
    position: absolute;
    top: -55px;
    transform: translateX(-50%);
    width: 160px;
  }

  .badge img {
    display: block;
    height: auto;
    width: 100px;
  }

  .ask {
    margin: 0 auto;
    max-width: 950px;
    text-align: center;
  }

  h2 {
    color: #fff;
    font-size: 34px;
    letter-spacing: 0.1em;
    margin: 0 0 30px;
  }

  .fields {
    gap: 15px;
  }

  .fields label {
    display: block;
    flex: 1;
  }

  input:not([type="checkbox"]),
  textarea {
    background-color: transparent;
    border: 1px solid rgb(255 255 255 / 40%);
    border-radius: 0;
    color: #fff;
    display: block;
    font-family: var(--font-body);
    font-size: 17px;
    margin: 0 0 15px;
    padding: 10px 20px;
    width: 100%;
  }

  input::placeholder,
  textarea::placeholder {
    color: rgb(255 255 255 / 50%);
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-brand);
    outline: none;
  }

  textarea {
    min-height: 135px;
    resize: vertical;
  }

  .consent {
    align-items: flex-start;
    color: rgb(255 255 255 / 50%);
    display: flex;
    font-size: 13px;
    font-style: italic;
    gap: 15px;
    justify-content: center;
    line-height: 1.5;
    margin: 10px auto 0;
    max-width: 700px;
    text-align: center;
  }

  .consent input {
    flex: 0 0 auto;
    margin-top: 3px;
  }

  button {
    background-color: var(--color-brand);
    border: none;
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-accent);
    font-size: 17px;
    letter-spacing: 0.05em;
    margin-top: 25px;
    padding: 15px 0;
    text-transform: uppercase;
    transition: background-color var(--animation-normal) ease-in-out;
    width: 275px;
  }

  button:hover {
    background-color: var(--color-brand-muted);
  }

  .info {
    margin: 50px auto 0;
    max-width: 1150px;
    text-align: center;
  }

  .info article {
    margin-bottom: 40px;
  }

  h3 {
    color: #fff;
    font-size: 22px;
    margin: 0 0 15px;
  }

  .phone {
    color: #fff;
    display: block;
    font-family: var(--font-accent);
    font-size: 30px;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .address {
    color: #fff;
    display: block;
    font-size: 17px;
    line-height: 1.4;
    margin-top: 10px;
    text-decoration: none;
  }

  .phone:hover,
  .address:hover {
    color: var(--color-brand);
  }

  .socials {
    display: flex;
    gap: 25px;
    justify-content: center;
    margin: 20px 0 0;
  }

  .socials a {
    align-items: center;
    background-color: var(--color-brand);
    border-radius: 50%;
    color: var(--color-text);
    display: flex;
    height: 45px;
    justify-content: center;
    transition: background-color var(--animation-normal) ease-in-out;
    width: 45px;
  }

  .socials a:hover {
    background-color: var(--color-brand-muted);
  }

  /* Fixed 20px box with the SVG filling it, so the symbol sits dead center in the circle */
  .socials :global(.icon) {
    display: block;
    height: 20px;
    width: 20px;
  }

  .socials :global(.icon svg) {
    display: block;
    height: 100%;
    width: 100%;
  }

  dl {
    display: inline-block;
    margin: 0;
    text-align: left;
  }

  dl div {
    display: flex;
    gap: 15px;
    line-height: 1.55;
  }

  dt {
    flex: 0 0 100px;
    font-weight: 700;
  }

  /* Keep each day's hours on one line; the list is only as wide as its longest row */
  dd {
    flex-shrink: 0;
    margin: 0;
    white-space: nowrap;
  }

  .no-time {
    font-style: italic;
  }

  .note {
    font-size: 15px;
    margin: 10px 0 0;
  }

  .legal {
    background-color: #fff;
    font-size: 16px;
    margin: 0 auto;
    max-width: 1150px;
    padding: 25px 20px;
    text-align: center;
  }

  .legal p {
    margin: 0;
  }

  .legal p + p {
    margin-top: 15px;
  }

  .separator {
    margin: 0 10px;
  }

  /* Phones: links on their own line under the copyright */
  .links {
    display: block;
    margin-top: 5px;
  }

  .links .separator:first-child {
    display: none;
  }

  .legal a {
    color: var(--color-brand-muted);
  }

  .credit {
    align-items: center;
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .credit a {
    color: #e2521d;
    display: block;
  }

  .credit :global(svg) {
    display: block;
    height: 45px;
    width: 80px;
  }

  @media (min-width: 1025px) {
    :global(
      main > section:last-child::after,
      main > editable-array > editable-array-item:last-child > section::after
    ) {
      height: 80px;
    }

    .main {
      padding: 190px 20px 70px;
    }

    .badge {
      height: 245px;
      padding-top: 55px;
      top: -80px;
      width: 245px;
    }

    .badge img {
      width: 170px;
    }

    h2 {
      font-size: 55px;
      margin-bottom: 35px;
    }

    .info {
      margin-top: 55px;
    }

    .info article {
      flex: 1;
      margin: 0;
      padding: 30px 20px;
    }

    /* Thin line between the two columns */
    .hours {
      border-left: 1px solid rgb(255 255 255 / 30%);
    }

    .legal p + p {
      margin-top: 0;
    }

    .links {
      display: inline;
      margin: 0;
    }

    .links .separator:first-child {
      display: inline;
    }
  }
</style>
