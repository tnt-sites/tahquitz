---
import bgTriangles from "@assets/images/bg-triangles.webp";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";

// Doctor bio banner: photo with a play button on the left, navy panel with the H1 eyebrow, name and intro on the right.
// The play button either opens a YouTube video in a popup ("modal") or scrolls down to a video on the page ("scroll").
const {
  id = "",
  eyebrow = "",
  heading = "",
  text = "",
  imageSource = "",
  imageAlt = "",
  videoAction = "modal",
  youtubeId = "",
  videoTitle = "",
  scrollTarget = "award-video",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const dialogId = `${id || "doctor-banner"}-video`;
const showModal = videoAction === "modal" && youtubeId;
const showScroll = videoAction === "scroll" && scrollTarget;
---

<section class:list={["doctor-banner", className]} id={id || undefined} {...htmlAttributes}>
  <div class="block lg:flex">
    <figure>
      <Image
        source={imageSource}
        alt={imageAlt}
        priority={true}
        data-prop-src="imageSource"
        data-prop-alt="imageAlt"
      />
      {
        showModal && (
          <button
            type="button"
            class="play"
            data-video-open={dialogId}
            aria-label={`Play ${videoTitle || "video"}`}
          >
            <Icon name="play" size="none" aria-hidden="true" />
          </button>
        )
      }
      {
        showScroll && (
          <a
            class="play"
            href={`#${scrollTarget}`}
            data-video-scroll
            aria-label="Watch the video below"
          >
            <Icon name="play" size="none" aria-hidden="true" />
          </a>
        )
      }
    </figure>
    <article style={`background-image: url(${bgTriangles.src})`}>
      {eyebrow && <h1 data-prop="eyebrow">{eyebrow}</h1>}
      {heading && <h2 data-prop="heading">{heading}</h2>}
      <Text text={text} data-prop="text" />
    </article>
  </div>
  {
    showModal && (
      <dialog
        id={dialogId}
        class="video-modal"
        data-youtube-id={youtubeId}
        aria-label={videoTitle || "Video"}
      >
        <button type="button" class="close" data-video-close aria-label="Close video">
          <Icon name="x-mark" size="none" aria-hidden="true" />
        </button>
        <div class="frame" />
      </dialog>
    )
  }
</section>

<!-- Modal: the YouTube iframe is only added when the popup opens, and removed on close so the video stops.
     Scroll: the page jumps to the video and starts it. -->
<script>
  document.querySelectorAll<HTMLButtonElement>("[data-video-open]").forEach((button) => {
    const dialog = document.getElementById(
      button.dataset.videoOpen || ""
    ) as HTMLDialogElement | null;
    if (!dialog) return;
    const frame = dialog.querySelector(".frame")!;

    button.addEventListener("click", () => {
      frame.innerHTML = `<iframe src="https://www.youtube.com/embed/${dialog.dataset.youtubeId}?autoplay=1&rel=0" title="${dialog.getAttribute("aria-label")}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
      dialog.showModal();
    });

    dialog.querySelector("[data-video-close]")?.addEventListener("click", () => dialog.close());
    // Clicking the dark backdrop closes it too
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => (frame.innerHTML = ""));
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-video-scroll]").forEach((link) => {
    link.addEventListener("click", () => {
      const target = document.querySelector(link.getAttribute("href") || "");
      target?.querySelector("video")?.play();
    });
  });
</script>

<style>
  .doctor-banner {
    background-color: var(--color-bg-dark);
    color: #fff;
  }

  figure {
    margin: 0;
    position: relative;
  }

  figure :global(img) {
    aspect-ratio: 4 / 3;
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
    width: 100%;
  }

  /* Light blue circle with a thin ring around it */
  .play {
    align-items: center;
    background-color: var(--color-brand);
    border: none;
    border-radius: 50%;
    bottom: 25px;
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    height: 70px;
    justify-content: center;
    outline: 1px solid var(--color-brand);
    outline-offset: 10px;
    padding: 0;
    position: absolute;
    right: 25px;
    transition: background-color var(--animation-normal) ease-in-out;
    width: 70px;
  }

  .play:hover {
    background-color: var(--color-brand-muted);
  }

  .play :global(.icon) {
    margin-left: 5px;
    width: 25px;
  }

  .play :global(svg) {
    display: block;
    height: auto;
    width: 100%;
  }

  .play :global(svg path) {
    fill: currentcolor;
  }

  article {
    background-position: center;
    background-size: cover;
    padding: 40px 20px 45px;
  }

  h1 {
    color: #fff;
    font-family: var(--font-accent);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.3;
    margin: 0 0 15px;
  }

  h2 {
    color: #fff;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
  }

  article :global(.text) {
    margin: 20px 0 0;
  }

  article :global(.text p) {
    color: #fff;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.75;
  }

  article :global(.text > * + *) {
    margin-top: 20px;
  }

  .video-modal {
    background-color: transparent;
    border: none;
    margin: auto;
    max-width: 1000px;
    overflow: visible;
    padding: 0;
    width: 90%;
  }

  .video-modal::backdrop {
    background-color: rgba(16, 29, 38, 0.85);
  }

  .frame {
    aspect-ratio: 16 / 9;
    background-color: #000;
  }

  .frame :global(iframe) {
    border: none;
    display: block;
    height: 100%;
    width: 100%;
  }

  .close {
    background-color: transparent;
    border: none;
    bottom: 100%;
    color: #fff;
    cursor: pointer;
    height: 45px;
    padding: 10px;
    position: absolute;
    right: 0;
    width: 45px;
  }

  @media (min-width: 1024px) {
    figure {
      width: 50%;
    }

    figure :global(img) {
      aspect-ratio: auto;
      min-height: 620px;
    }

    .play {
      bottom: 60px;
      height: 110px;
      right: 40px;
      width: 110px;
    }

    .play :global(.icon) {
      width: 35px;
    }

    article {
      padding: 70px 50px 70px 70px;
      width: 50%;
    }

    article > * {
      max-width: 520px;
    }

    h1 {
      font-size: 17px;
    }

    h2 {
      font-size: 55px;
    }
  }
</style>
