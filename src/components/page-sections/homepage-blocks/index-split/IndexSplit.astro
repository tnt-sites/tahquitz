---
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

// Homepage section: heading, copy and buttons beside a wide photo that runs to the edge of the screen
// on desktop (photo on the right unless imageLeft). Photo first on phones.
const {
  id = "",
  heading = "",
  subtext = "",
  buttonSections = [],
  imageSource = "",
  imageAlt = "",
  imageLeft = false,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<section
  class:list={["index-split", { "image-left": imageLeft }, className]}
  id={id || undefined}
  {...htmlAttributes}
>
  <div class="block text-center">
    {
      imageSource && (
        <figure>
          <Image
            source={imageSource}
            alt={imageAlt}
            sizes="(min-width: 1025px) 50vw, 100vw"
            data-prop-src="imageSource"
            data-prop-alt="imageAlt"
          />
        </figure>
      )
    }
    <article>
      {heading && <h2 data-prop="heading">{heading}</h2>}
      <Text text={subtext} data-prop="subtext" />
      {
        buttonSections.length > 0 && (
          <ButtonGroup buttonSections={buttonSections} width="content" alignX="start" />
        )
      }
    </article>
  </div>
</section>

<style>
  .index-split {
    padding: 0 0 60px;
  }

  figure {
    margin: 0 0 40px;
  }

  /* Full width above the text on phones and tablets, capped so it doesn't fill a tablet screen */
  figure :global(img) {
    aspect-ratio: 16 / 9;
    display: block;
    height: auto;
    max-height: 450px;
    object-fit: cover;
    width: 100%;
  }

  article {
    margin: 0 auto;
    max-width: 590px;
    padding: 0 20px;
  }

  h2 {
    font-size: 40px;
    line-height: 1.1;
    margin: 0 0 25px;
  }

  article :global(.text) {
    margin: 0;
    text-align: inherit;
  }

  article :global(.text p) {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
  }

  article :global(.text > * + *) {
    margin-top: 20px;
  }

  /* The button group shrinks to fit its buttons, so center the group itself on phones */
  article :global(.button-group) {
    margin: 25px auto 0;
  }

  article :global(.button) {
    font-size: 17px;
    justify-content: center;
    min-width: 275px;
    padding: 15px 20px;
  }

  @media (min-width: 1025px) {
    .index-split {
      padding: 90px 0 105px;
    }

    /* Desktop layout is set here, not with lg: classes, because Tailwind's lg starts at 1024px on this site */
    .index-split > div {
      align-items: center;
      display: flex;
      flex-direction: row-reverse;
      text-align: left;
    }

    .image-left > div {
      flex-direction: row;
    }

    /* Empty space on the text side the width of the page gutter, so the text lines up with the
       1150px content column while the photo runs to the edge of the screen */
    .index-split > div::after {
      content: "";
      flex: 1 0 0;
      min-width: 20px;
    }

    figure {
      align-self: flex-start;
      flex: 1 1 535px;
      margin: 0;
    }

    article {
      flex: 0 1 615px;
      margin: 0;
      max-width: none;
      padding: 0 60px 0 0;
    }

    .image-left article {
      padding: 0 0 0 60px;
    }

    h2 {
      font-size: 55px;
      line-height: 1.1;
      margin-bottom: 30px;
      max-width: 500px;
    }

    article :global(.text) {
      max-width: 500px;
    }

    article :global(.text p) {
      font-size: 19px;
      line-height: 1.6;
    }

    article :global(.button-group) {
      margin: 35px 0 0;
    }
  }
</style>
