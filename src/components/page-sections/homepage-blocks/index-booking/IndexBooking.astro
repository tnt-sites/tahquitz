---
import Button from "@core-elements/button/Button.astro";
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";

// Homepage "3 Easy Ways to Book": light blue band with a row of outlined cards. Each card's icon sits in a
// gap in its top border and its navy button straddles the bottom border. Cards stack on phones and tablets.
const {
  id = "",
  heading = "",
  ways = [],
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<section class:list={["index-booking", className]} id={id || undefined} {...htmlAttributes}>
  <div class="block text-center">
    {heading && <h2 data-prop="heading">{heading}</h2>}
    <ul class="no-check">
      {
        ways.map((way: any, index: number) => (
          <li>
            <figure>
              <Image
                source={way.iconSource}
                alt={way.iconAlt}
                data-prop-src={`ways.${index}.iconSource`}
                data-prop-alt={`ways.${index}.iconAlt`}
              />
            </figure>
            <article>
              <h3 data-prop={`ways.${index}.title`}>{way.title}</h3>
              <Text text={way.text} data-prop={`ways.${index}.text`} />
            </article>
            {way.buttonText && way.link && (
              <Button
                text={way.buttonText}
                link={way.link}
                variant="primary"
                borderRadius="none"
                uppercase={true}
                editable={false}
              />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .index-booking {
    background-color: var(--color-brand);
    padding: 60px 20px 70px;
  }

  .index-booking > div {
    margin: 0 auto;
    max-width: 1150px;
  }

  h2 {
    font-size: 40px;
    line-height: 1.1;
    margin: 0 0 20px;
  }

  /* The starter's list styles left-align every list in main */
  ul {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 0;
    text-align: inherit;
  }

  li {
    align-items: center;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    max-width: 375px;
    padding: 0;
    width: 100%;
  }

  /* Top border with a gap for the icon: a line either side, 25px up from the icon's bottom */
  figure {
    align-items: flex-end;
    align-self: stretch;
    display: flex;
    margin: 0;
  }

  figure::before,
  figure::after {
    border-top: 1px solid var(--color-text);
    content: "";
    flex: 1;
    height: 25px;
  }

  figure::before {
    border-left: 1px solid var(--color-text);
  }

  figure::after {
    border-right: 1px solid var(--color-text);
  }

  figure :global(.image) {
    margin: 0;
    padding: 0 25px;
  }

  figure :global(img) {
    display: block;
    height: 70px;
    max-width: 80px;
    object-fit: contain;
    width: auto;
  }

  /* Sides and bottom of the card; the button below covers the middle of the bottom border */
  article {
    align-self: stretch;
    border: 1px solid var(--color-text);
    border-top: 0;
    flex: 1;
    padding: 25px 20px 50px;
  }

  h3 {
    font-size: 21px;
    line-height: 1.25;
    margin: 0 0 15px;
  }

  article :global(.text) {
    margin: 0 auto;
    max-width: 260px;
    text-align: inherit;
  }

  article :global(.text p) {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
  }

  li > :global(.button) {
    background-color: var(--color-bg-dark);
    color: #fff;
    font-size: 17px;
    justify-content: center;
    margin-top: -25px;
    min-width: 275px;
    padding: 15px 20px;
  }

  li > :global(.button:hover) {
    background-color: #000;
    color: #fff;
  }

  @media (min-width: 1025px) {
    .index-booking {
      padding: 80px 20px 90px;
    }

    h2 {
      font-size: 55px;
      margin-bottom: 15px;
    }

    ul {
      align-items: stretch;
      flex-direction: row;
      gap: 15px;
      justify-content: center;
    }

    li {
      flex: 0 1 375px;
      margin: 0;
    }

    /* Titles stay on one line; smaller until the cards reach full width */
    h3 {
      font-size: 18px;
      margin-bottom: 10px;
      white-space: nowrap;
    }

    article :global(.text p) {
      font-size: 19px;
      line-height: 1.6;
    }
  }

  @media (min-width: 1280px) {
    h3 {
      font-size: 21px;
    }
  }
</style>
