---
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

// Service page section: heading, copy and buttons beside a photo (photo on the right unless imageLeft).
// compact = smaller sub-item (small photo, Josefin heading) used for lists like "Types of Implant Treatments".
const {
  id = "",
  anchorName = "",
  heading = "",
  subtext = "",
  buttonSections = [],
  imageSource = "",
  imageAlt = "",
  imageLeft = false,
  compact = false,
  background = "white",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const HeadingTag = compact ? "h3" : "h2";
---

<section
  class:list={["service-split", `bg-${background}`, { compact, "no-image": !imageSource }, className]}
  id={id || undefined}
  {...htmlAttributes}
>
  {anchorName && <a name={anchorName} class="anchor-name-offset" aria-hidden="true" />}
  <div
    class:list={[
      "block text-center lg:text-left lg:flex justify-between items-center",
      { "lg:flex-row-reverse": !imageLeft },
    ]}
  >
    {
      imageSource && (
        <figure>
          <Image
            source={imageSource}
            alt={imageAlt}
            data-prop-src="imageSource"
            data-prop-alt="imageAlt"
          />
        </figure>
      )
    }
    <article>
      {heading && <HeadingTag data-prop="heading">{heading}</HeadingTag>}
      <Text text={subtext} data-prop="subtext" />
      {
        buttonSections.length > 0 && (
          <ButtonGroup buttonSections={buttonSections} width="content" alignX="start" />
        )
      }
    </article>
  </div>
</section>

<style>
  .service-split {
    padding: 50px 20px;
  }

  .service-split.bg-tint {
    background-color: #e1f6ff;
  }

  .service-split > div {
    max-width: 1150px;
    margin: 0 auto;
  }

  figure {
    max-width: 500px;
    margin: 0 auto 30px;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  article {
    max-width: 590px;
    margin: 0 auto;
  }

  .no-image article {
    max-width: 900px;
  }

  h2 {
    margin: 0 0 20px;
    font-size: 36px;
    line-height: 1.1;
  }

  h3 {
    margin: 0 0 15px;
    font-size: 22px;
    line-height: 1.25;
  }

  article :global(.text) {
    margin: 0;
    text-align: inherit;
  }

  article :global(.text p),
  article :global(.text li) {
    font-size: 17px;
    line-height: 1.75;
  }

  article :global(.text > * + *) {
    margin-top: 20px;
  }

  article :global(.text ul) {
    margin-bottom: 0;
  }

  article :global(.button-group) {
    margin-top: 25px;
  }

  article :global(.button-group > *) {
    justify-content: center;
  }

  .compact {
    padding-block: 25px;
  }

  .compact figure {
    max-width: 300px;
  }

  .compact figure :global(img) {
    aspect-ratio: 3 / 2;
  }

  .compact article {
    max-width: 800px;
  }

  @media (min-width: 1024px) {
    .service-split {
      padding: 100px 20px;
    }

    figure {
      flex: 0 0 500px;
      margin: 0;
    }

    article {
      margin: 0;
    }

    h2 {
      font-size: 55px;
    }

    h3 {
      font-size: 29px;
    }

    article :global(.button-group > *) {
      justify-content: flex-start;
    }

    .compact {
      padding-block: 25px;
    }

    .compact figure {
      flex: 0 0 300px;
    }

    .compact article {
      flex: 1;
      margin-left: 60px;
    }

    .compact .lg\:flex-row-reverse article {
      margin: 0 60px 0 0;
    }
  }
</style>
