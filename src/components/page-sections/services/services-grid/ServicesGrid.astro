---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Icon from "@core-elements/icon/Icon.astro";
import ServicesGridItem from "./ServicesGridItem.astro";

type ServiceLink = {
  _component?: string;
  label?: string;
  text?: string;
  href?: string;
};

type ServiceItem = {
  _component?: string;
  imageSource?: string;
  imageAlt?: string;
  title?: string;
  href?: string;
  wide?: boolean | string;
  links?: ServiceLink[];
};

type ServicesGridCta = {
  enabled?: boolean | string;
  id?: string;
  href?: string;
  heading?: string;
  buttonText?: string;
  iconName?: string;
  wide?: boolean | string;
};

const {
  heading = "",
  services = [],
  ctaCard,
  backgroundColor = "base",
  backgroundGradient = "",
  id = "",
  backgroundImage,
  class: className,
  editable = true,
  _component,
  ...rest
} = Astro.props;

const isTrue = (value: unknown) =>
  typeof value === "string" ? value.trim().toLowerCase() === "true" : !!value;

const cleanText = (value: unknown, fallback = "") =>
  typeof value === "string" && value.trim().length > 0 ? value.trim() : fallback;

const stripP = (value: string) =>
  value
    .trim()
    .replace(/<\/p>\s*<p(?:\s[^>]*)?>/gi, "<br>")
    .replace(/^<p(?:\s[^>]*)?>/i, "")
    .replace(/<\/p>\s*$/i, "");

const normalizeLabel = (link: ServiceLink) => cleanText(link.label, cleanText(link.text));

const normalizeLinks = (links: unknown) =>
  Array.isArray(links)
    ? links
        .filter((link): link is ServiceLink => !!link && typeof link === "object")
        .map((link) => ({
          label: normalizeLabel(link),
          href: cleanText(link.href, "#"),
        }))
        .filter((link) => link.label.length > 0)
    : [];

const normalizedServices = Array.isArray(services)
  ? services
      .filter((service): service is ServiceItem => !!service && typeof service === "object")
      .map((service) => ({
        title:
          typeof service.title === "string" && service.title.trim().length > 0
            ? stripP(service.title)
            : "Service",
        href: cleanText(service.href, "#"),
        imageSource: cleanText(service.imageSource),
        imageAlt: cleanText(service.imageAlt),
        wide: isTrue(service.wide),
        links: normalizeLinks(service.links),
      }))
  : [];

const rawCtaCard = !!ctaCard && typeof ctaCard === "object" ? (ctaCard as ServicesGridCta) : {};
const normalizedCtaCard = {
  enabled: rawCtaCard.enabled === undefined ? false : isTrue(rawCtaCard.enabled),
  id: cleanText(rawCtaCard.id, "all").replace(/^#/, "") || "all",
  href: cleanText(rawCtaCard.href, "request-an-appointment.html"),
  heading:
    typeof rawCtaCard.heading === "string" && rawCtaCard.heading.trim().length > 0
      ? stripP(rawCtaCard.heading)
      : "Get Started Now",
  buttonText: cleanText(rawCtaCard.buttonText, "Request an Appointment"),
  iconName: cleanText(rawCtaCard.iconName),
  wide: rawCtaCard.wide === undefined ? true : isTrue(rawCtaCard.wide),
};

const hasServices = normalizedServices.length > 0;
const hasHeading = typeof heading === "string" && heading.trim().length > 0;
const hasCtaCard = normalizedCtaCard.enabled;

const servicesArrayDataAttributes = editable
  ? {
      "data-editable": "array",
      "data-component-key": "_component",
      "data-id-key": "_component",
      "data-prop": "services",
    }
  : {};

if (!_component && !hasHeading && !hasServices && !hasCtaCard) {
  return;
}

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["services-grid", className]}
  id={id || undefined}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundGradient={backgroundGradient}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  {
    (hasServices || hasCtaCard) && (
      <div class="services-grid-items" {...servicesArrayDataAttributes}>
        {normalizedServices.map((service) => (
          <editable-array-item
            data-component="page-sections/services/services-grid/services-grid-item"
            class:list={["services-grid-item", service.wide && "is-wide"]}
          >
            <ServicesGridItem {...service} editable={editable} />
          </editable-array-item>
        ))}

        {hasCtaCard && (
          <div
            id={normalizedCtaCard.id}
            class:list={[
              "services-grid-item",
              "services-grid-cta",
              normalizedCtaCard.wide && "is-wide",
            ]}
          >
            <a href={normalizedCtaCard.href}>
              <div class="services-grid-cta-heading h2">
                <Fragment set:html={normalizedCtaCard.heading} />
              </div>
              <div class="services-grid-cta-button btn btn-white">
                {normalizedCtaCard.iconName && (
                  <Icon name={normalizedCtaCard.iconName} size="none" aria-hidden="true" />
                )}
                {normalizedCtaCard.buttonText}
              </div>
            </a>
          </div>
        )}
      </div>
    )
  }
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .services-grid {
      position: relative;

      .services-grid-items {
        align-items: stretch;
        display: flex;
        flex-wrap: wrap;
        gap: 40px 15px;
        justify-content: center;
        margin: 0 auto;
      }

      .services-grid-items > editable-array-item,
      .services-grid-items > .services-grid-item {
        display: flex;
        flex: 0 1 360px;
        flex-direction: column;
      }

      .services-grid-item .services-grid-item {
        display: flex;
        flex: 1;
        flex-direction: column;
      }

      /* Top border with a gap for the icon: two lines either side, 20px up from the icon's bottom */
      .services-grid-figure {
        align-items: flex-end;
        display: flex;
        margin: 0;

        &::before,
        &::after {
          border-top: 1px solid var(--color-text);
          content: "";
          flex: 1;
          height: 20px;
        }

        &::before {
          border-left: 1px solid var(--color-text);
        }

        &::after {
          border-right: 1px solid var(--color-text);
        }

        .image {
          margin: 0;
          padding: 0 25px;
        }

        /* 60px tall; wide icons (e.g. the row of teeth) shrink to fit 100px and sit on the border line */
        img {
          display: block;
          height: 60px;
          max-width: 100px;
          object-fit: contain;
          object-position: center bottom;
          width: auto;
        }
      }

      .services-grid-content {
        border: 1px solid var(--color-text);
        border-top: none;
        flex: 1;
        padding: 15px 20px 30px;
      }

      .services-grid-title {
        font-family: var(--font-accent);
        font-size: 22px;
        font-weight: 600;
        letter-spacing: 0.1em;
        line-height: 1.2;
        margin: 0;
        text-align: center;
        text-transform: uppercase;

        a {
          color: var(--color-text);
          text-decoration: none;
        }
      }

      .services-grid-title:hover a,
      .services-grid-title:focus-within a {
        color: var(--color-brand-secondary);
      }

      .services-grid-links {
        margin: 20px 0 0;
        padding: 0;

        editable-array-item {
          display: block;
          font-size: 17px;
          font-weight: 600;
          line-height: 1.2;
          margin: 0 0 10px;
          padding-left: 35px;
          position: relative;
        }

        /* Navy check mark (fontello icon-ok-1) */
        editable-array-item::before {
          color: var(--color-text);
          content: "\e832";
          font-family: fontello, sans-serif;
          font-size: 21px;
          left: 0;
          line-height: 1;
          position: absolute;
          top: 0;
        }

        a {
          color: var(--color-text);
          text-decoration: none;
        }
      }

      .services-grid-links editable-array-item:hover a,
      .services-grid-links editable-array-item:focus-within a {
        color: var(--color-brand-secondary);
      }

      /* "Ready to get started?" tile: starts level with the cards' top border */
      .services-grid-cta {
        align-items: center;
        background-color: var(--color-bg-dark);
        display: flex;
        justify-content: center;
        margin-top: 40px;
        min-height: 300px;
        text-align: center;

        a {
          align-items: center;
          display: flex;
          flex-direction: column;
          gap: 20px;
          padding: 30px 20px;
          text-decoration: none;
        }
      }

      .services-grid-cta-heading {
        color: #fff;
        font-size: 45px;
        font-weight: var(--font-weight-light);
        letter-spacing: 0.05em;
        line-height: 1.1;
        text-transform: uppercase;
      }

      .services-grid-cta-button {
        align-items: center;
        background-color: var(--color-brand);
        color: var(--color-text);
        display: inline-flex;
        font-family: var(--font-accent);
        font-size: 20px;
        gap: 10px;
        padding: 10px 25px;
        text-transform: uppercase;
        transition: background-color var(--animation-normal) ease-in-out;

        .icon {
          width: 25px;
        }
      }

      .services-grid-cta:hover .services-grid-cta-button,
      .services-grid-cta:focus-within .services-grid-cta-button {
        background-color: var(--color-brand-muted);
      }
    }
  }
</style>
