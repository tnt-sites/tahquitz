---
import Form from "@forms/form/Form.astro";
import Icon from "@core-elements/icon/Icon.astro";

// Popup with one offer's form, shared by the Special Offers cards and the homepage banner's offers.
// Any button with data-offer-open="<id>" opens it, and so does a link ending in #<id>
// (e.g. /promotions/#specials-offer-1). The form sends the offer name in a hidden "promotion" field.
const { id, amount = "", treatment = "", formText = "", formAction = "" } = Astro.props;

const formBlocks = [
  {
    _component: "building-blocks/forms/input",
    label: "Name",
    name: "name",
    type: "text",
    placeholder: "Name",
    required: true,
  },
  {
    _component: "building-blocks/forms/input",
    label: "Email",
    name: "email",
    type: "email",
    placeholder: "Email",
    required: true,
  },
  {
    _component: "building-blocks/forms/input",
    label: "Phone",
    name: "phone",
    type: "tel",
    placeholder: "Phone",
    required: true,
  },
  {
    _component: "building-blocks/forms/textarea",
    label: "Comments",
    name: "comments",
    placeholder: "Comments",
    required: false,
  },
  {
    _component: "building-blocks/forms/hidden",
    name: "promotion",
    value: `${amount} ${treatment}`.trim(),
  },
  {
    _component: "building-blocks/forms/submit",
    text: "Redeem Offer",
    borderRadius: "none",
    uppercase: true,
  },
];
---

<dialog id={id} class="offer-modal" aria-label={`${amount} ${treatment}`.trim()}>
  <button type="button" class="close" data-offer-close aria-label="Close">
    <Icon name="x-mark" size="none" aria-hidden="true" />
  </button>
  <h3>
    {amount} <span>{treatment}</span>
  </h3>
  {formText && <p>{formText}</p>}
  <Form action={formAction} formBlocks={formBlocks} editable={false} />
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>("dialog.offer-modal").forEach((dialog) => {
    const openers = document.querySelectorAll<HTMLElement>(`[data-offer-open="${dialog.id}"]`);
    openers.forEach((button) => button.addEventListener("click", () => dialog.showModal()));
    dialog.querySelector("[data-offer-close]")?.addEventListener("click", () => dialog.close());
    // Clicking the dark backdrop closes it too
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    if (location.hash === `#${dialog.id}`) {
      openers[0]?.scrollIntoView({ block: "center" });
      dialog.showModal();
    }
  });
</script>

<style>
  .offer-modal {
    border: none;
    margin: auto;
    max-width: 600px;
    padding: 45px 25px 35px;
    text-align: center;
    width: 90%;
  }

  .offer-modal::backdrop {
    background-color: rgb(16 29 38 / 85%);
  }

  h3 {
    font-family: var(--font-accent);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0;
    text-transform: uppercase;
  }

  h3 span {
    display: block;
    font-size: 18px;
    letter-spacing: 0.1em;
    margin-top: 5px;
  }

  p {
    font-size: 17px;
    margin: 15px 0 0;
  }

  .offer-modal :global(.form) {
    margin-top: 20px;
    text-align: left;
  }

  .offer-modal :global(.form > * + *) {
    margin-top: 15px;
  }

  .offer-modal :global(.submit) {
    display: block;
    margin: 25px auto 0;
  }

  .close {
    background-color: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    height: 45px;
    padding: 10px;
    position: absolute;
    right: 5px;
    top: 5px;
    width: 45px;
  }

  @media (min-width: 1025px) {
    .offer-modal {
      padding: 50px 50px 40px;
    }
  }
</style>
