---
import bgTriangles from "@assets/images/bg-triangles.webp";
import OfferModal from "./OfferModal.astro";

// Special offer cards (styleguide "Specials"): navy card with the discount, light blue band with the
// treatment, and a Redeem Offer button on the bottom edge that opens that offer's own form in a popup.
// Each form sends the offer name in a hidden "promotion" field, and can post to its own form address.
const {
  id = "",
  heading = "",
  formText = "",
  formAction = "",
  offers = [],
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const sectionId = id || "special-offers";
---

<section class:list={["special-offers", className]} id={id || undefined} {...htmlAttributes}>
  <div class="block text-center">
    {heading && <h2 data-prop="heading">{heading}</h2>}
    <div class="offers block lg:flex justify-center">
      {
        offers.map((offer: any, index: number) => (
          <article style={`background-image: url(${bgTriangles.src})`}>
            <strong>{offer.amount}</strong>
            <span class="treatment">{offer.treatment}</span>
            {offer.buttonText && (
              <button
                type="button"
                class="redeem"
                data-offer-open={`${sectionId}-offer-${index + 1}`}
              >
                {offer.buttonText}
              </button>
            )}
          </article>
        ))
      }
    </div>
  </div>
  {
    offers.map((offer: any, index: number) => (
      <OfferModal
        id={`${sectionId}-offer-${index + 1}`}
        amount={offer.amount}
        treatment={offer.treatment}
        formText={formText}
        formAction={offer.formAction || formAction}
      />
    ))
  }
</section>

<style>
  .special-offers {
    padding: 60px 20px;
  }

  .special-offers > div {
    margin: 0 auto;
    max-width: 1150px;
  }

  h2 {
    font-size: 32px;
    margin: 0 0 40px;
  }

  .offers {
    gap: 15px;
  }

  article {
    background-color: var(--color-bg-dark);
    background-position: center;
    background-size: cover;
    border-radius: 15px;
    margin: 0 auto 50px;
    max-width: 375px;
    padding: 30px 0 60px;
    position: relative;
  }

  strong {
    color: #fff;
    display: block;
    font-family: var(--font-accent);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .treatment {
    background-color: var(--color-brand);
    display: block;
    font-family: var(--font-accent);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-top: 15px;
    padding: 8px 10px 5px;
    text-transform: uppercase;
  }

  /* Sits on the card's bottom edge */
  .redeem {
    background-color: var(--color-brand);
    border: 2px solid var(--color-text);
    bottom: -25px;
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-accent);
    font-size: 16px;
    left: 50%;
    padding: 12px 0;
    position: absolute;
    text-transform: uppercase;
    transform: translateX(-50%);
    transition: background-color var(--animation-normal) ease-in-out;
    width: 275px;
  }

  .redeem:hover {
    background-color: var(--color-brand-muted);
  }

  @media (min-width: 1025px) {
    .special-offers {
      padding: 80px 20px 90px;
    }

    h2 {
      font-size: 55px;
      margin-bottom: 50px;
    }

    article {
      flex: 0 1 375px;
      margin: 0;
    }

    strong {
      font-size: 50px;
    }
  }
</style>
